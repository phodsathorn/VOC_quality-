# Copy to .env only for local development. Never commit the real connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ==================================================================
# Phase W0 Security & Access Control Configuration
# ==================================================================
# Secret key for securing high-risk endpoints (/api/model/upload, /api/ota/upload, rollback, etc.)
ADMIN_API_KEY=change-this-to-a-secure-random-token-in-production
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://voc-quality.web.app

# Data Retention Policy (W0/W3 5-Year Compliance Policy)
# Keep sensor readings for 5 years (1825 days). Auto-purge is disabled by default.
ENABLE_AUTO_PURGE=false
DATA_RETENTION_DAYS=1825

# ==================================================================
# Phase W1 Authentication & RBAC Configuration
# ==================================================================
JWT_SECRET_KEY=change-this-to-a-secure-random-jwt-secret-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Default Seed Accounts (Auto-seeded if users table is empty):
# 1. admin:    Admin@Voc2026!    (Role: admin)
# 2. engineer: Engineer@Voc2026! (Role: engineer)
# 3. operator: Operator@Voc2026! (Role: operator)
# 4. viewer:   Viewer@Voc2026!   (Role: viewer)
#
# Default Device Token for BOX-001:
# esp32_voc_box001_token_2026
